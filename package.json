{
  "name": "@aihu/server",
  "version": "0.6.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    },
    "./head-lowering": {
      "types": "./dist/head-lowering.d.ts",
      "import": "./dist/head-lowering.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "rolldown -c",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-native/Cargo.toml",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check:lint": "biome ci .",
    "check:platform-pins": "bun scripts/check-platform-pins.ts",
    "check:ci": "bun run check:lint && bun run typecheck && bun run test && bun run test:rust && bun run build && bun run check:platform-pins && bun pm pack --dry-run",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@aihu/agent": "^0.2.0",
    "@aihu/agent-service": "^0.4.0",
    "@aihu/plugin": "^0.1.0",
    "@aihu/signals": "^0.5.1"
  },
  "optionalDependencies": {
    "@aihu/server-darwin-arm64": "0.1.2",
    "@aihu/server-darwin-x64": "0.1.2",
    "@aihu/server-linux-x64-gnu": "0.1.2",
    "@aihu/server-win32-x64-msvc": "0.1.2"
  },
  "description": "Server runtime + native renderer (napi-rs) for aihu SSR.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aihu-project/aihu-server.git"
  },
  "homepage": "https://github.com/aihu-project/aihu-server#readme",
  "bugs": "https://github.com/aihu-project/aihu-server/issues",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@aihu/arbor": "^4.1.2",
    "@aihu/runtime": "^6.1.0",
    "@biomejs/biome": "2.4.14",
    "@types/node": "^20.16.5",
    "fast-check": "^3.22.0",
    "rolldown": "^1.0.0-rc.17",
    "rolldown-plugin-dts": "^0.23.2",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  }
}
